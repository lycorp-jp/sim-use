+  /// `source` cut to `sourceCrop`, or nil without a crop. Core Image has a bottom-left origin.
+  func croppedFrame(_ source: CVPixelBuffer) -> CVPixelBuffer? {
+    guard let crop = sourceCrop, let cropBufferPool, let compositorCIContext else {
+      return nil
+    }
+    let sourceHeight = CGFloat(CVPixelBufferGetHeight(source))
+    let rect = CGRect(x: crop.minX, y: sourceHeight - crop.maxY, width: crop.width, height: crop.height)
+    let image = CIImage(cvPixelBuffer: source)
+      .cropped(to: rect)
+      .transformed(by: CGAffineTransform(translationX: -rect.minX, y: -rect.minY))
+    var output: CVPixelBuffer?
+    guard CVPixelBufferPoolCreatePixelBuffer(nil, cropBufferPool, &output) == kCVReturnSuccess, let output else {
+      return nil
+    }
+    compositorCIContext.render(image, to: output)
+    return output
+  }
