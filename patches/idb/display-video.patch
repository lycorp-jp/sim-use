index ea8359d91..f9f3fd2f1 100644
--- a/FBSimulatorControl/Framebuffer/FBFramebuffer.swift
+++ b/FBSimulatorControl/Framebuffer/FBFramebuffer.swift
@@ -91,6 +91,35 @@ public final class FBFramebuffer: NSObject, @unchecked Sendable {
     throw FBSimulatorError.describe("Could not find the Main Screen Surface for Clients \(FBCollectionInformation.oneLineDescription(from: ports)) in \(ioClient)").build()
   }
 
+  /// The display port whose default size is `pixelWidth` x `pixelHeight` (unrotated pixels). A
+  /// simulator with more than one display — the iPhone Duo cover and inner panels are both display
+  /// class 0, the Resize Mode canvas is class 1 — needs the port named by its size; the main-screen
+  /// lookup above returns the first class-0 port only.
+  @objc(surfaceForSimulator:pixelWidth:pixelHeight:logger:error:)
+  public class func surface(for simulator: FBSimulator, pixelWidth: Int, pixelHeight: Int, logger: any FBControlCoreLogger) throws -> FBFramebuffer {
+    let ioClient = simulator.device.io!
+    guard let ports = ioClient.ioPorts() as [Any]? else {
+      throw FBSimulatorError.describe("No IO ports available on \(ioClient)").build()
+    }
+    for port in ports {
+      guard let portInterface = port as? SimDeviceIOPortInterface else {
+        continue
+      }
+      let descriptor = portInterface.descriptor as AnyObject
+      guard descriptor.conforms(to: SimDisplayRenderable.self),
+        descriptor.conforms(to: SimDisplayIOSurfaceRenderable.self),
+        descriptor.responds(to: NSSelectorFromString("state"))
+      else {
+        continue
+      }
+      let state = descriptor.perform(NSSelectorFromString("state"))?.takeUnretainedValue() as! SimDisplayDescriptorState
+      if Int(state.defaultWidthForDisplay) == pixelWidth && Int(state.defaultHeightForDisplay) == pixelHeight {
+        return FBFramebuffer(surface: descriptor, logger: logger)
+      }
+    }
+    throw FBSimulatorError.describe("No display port of \(pixelWidth)x\(pixelHeight) pixels among \(FBCollectionInformation.oneLineDescription(from: ports)) in \(ioClient)").build()
+  }
+
   private init(surface: AnyObject, logger: any FBControlCoreLogger) {
     self.consumers = NSMapTable(keyOptions: .weakMemory, valueOptions: .copyIn)
     self.logger = logger
