+  fileprivate func createStreamAsync(configuration: FBVideoStreamConfiguration, displayPixelWidth: Int, displayPixelHeight: Int, sourceCrop: CGRect?, to consumer: any FBDataConsumer) async throws -> any FBVideoStream {
+    guard let simulator = self.simulator else {
+      throw FBSimulatorVideoRecordingCommandError.simulatorDeallocated
+    }
+    let logger = simulator.logger!
+    let framebuffer = try FBFramebuffer.surface(for: simulator, pixelWidth: displayPixelWidth, pixelHeight: displayPixelHeight, logger: logger)
+    let stream = FBSimulatorVideoStream.make(framebuffer: framebuffer, configuration: configuration, logger: logger)
+    stream.sourceCrop = sourceCrop
+    try await stream.startStreaming(consumer)
+    return stream
+  }
 }
 
